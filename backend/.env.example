# Local configuration: KEY=value without quotes or export prefixes.
# Loaded as Java properties, not by a shell dotenv parser.
PORT=8080

# Development database. Data resets on restart.
# PostgreSQL also requires its JDBC dependency and production schema/seed settings.
DB_URL=jdbc:h2:mem:stockpulse;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=

# Groq configuration. Reserved for future integration, not active yet.
# Paste your key into .env only. Never commit it or put it in frontend code.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Listed in Groq's Free plan limits; confirm availability in your account.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=20s
